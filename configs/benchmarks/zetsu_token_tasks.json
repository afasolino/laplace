        "answer_exact": "routing=src/research_workspace/model_routing.py\nproduction_model=src/research_workspace/production_model.py\nqwen38_manifest=configs/model_manifests/qwen38_27b_a6000.json\nproduction_profile=configs/serving_profiles/P8_qwen38_w4a16_mtp.json\n"
      }
    },
    {
      "id": "zetsu_architecture",
      "kind": "read_only",
      "prompt": "Inspect the frozen repository and return exactly these four Zetsu architecture facts as four `key=path` lines, with no prose: mcp, qwen_agent, routing, skill.",
      "correctness": {
        "type": "answer_contains_paths",
