    {
      "id": "tiny_agent_change",
      "kind": "implementation",
      "prompt": "Implement this exact small change: add a --print-task-kinds option to scripts/benchmark_zetsu_token_efficiency.py. It must print each configured benchmark task as ID:kind in task order, one per line, and exit 0 without requiring result_root. Extend the focused tests in tests/test_zetsu_token_benchmark.py. Do not change other behavior.",
      "correctness": {
        "type": "commands",
        "commands": [
          {
            "argv": [
              "python",
              "scripts/benchmark_zetsu_token_efficiency.py",
              "--print-task-kinds"
            ],
            "stdout_exact": "routing:read_only\nzetsu_architecture:read_only\ntiny_agent_change:implementation\n"
          },
          {
            "argv": [
              "python",
              "-m",
              "pytest",
              "tests/test_zetsu_token_benchmark.py",
              "-q"
            ],
            "returncode": 0
          }
        ],
        "allowed_changed_paths": [
          "scripts/benchmark_zetsu_token_efficiency.py",
          "tests/test_zetsu_token_benchmark.py"
        ],
        "required_changed_paths": [
          "scripts/benchmark_zetsu_token_efficiency.py",
          "tests/test_zetsu_token_benchmark.py"
        ]
      }
    }
  ]
