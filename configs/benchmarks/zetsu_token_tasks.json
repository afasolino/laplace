        "required_paths": [
          "src/research_workspace/model_routing.py",
          "src/research_workspace/production_model.py",
          "configs/model_manifests/qwen38_27b_a6000.json",
          "configs/serving_profiles/P8_qwen38_w4a16_mtp.json"
