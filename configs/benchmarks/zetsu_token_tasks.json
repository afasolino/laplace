        "answer_exact": "mcp=src/research_workspace/zetsu_mcp.py\nqwen_agent=src/research_workspace/zetsu_agent.py\nrouting=src/research_workspace/model_routing.py\nskill=.agents/skills/zetsu/SKILL.md\n"
      }
