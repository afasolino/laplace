# Explicit host only: do not make this the default_server.
limit_req_zone $binary_remote_addr zone=laplace_login:10m rate=10r/m;
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name laplace.example.org;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name laplace.example.org;

    ssl_certificate /etc/letsencrypt/live/laplace.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/laplace.example.org/privkey.pem;
    client_max_body_size 2m;
    client_body_timeout 30s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /api/v1/auth/login {
        limit_req zone=laplace_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8765;
        include /etc/nginx/proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15m;
        proxy_send_timeout 15m;
    }
}

# Private-LAN option: issue a certificate from an organization/private CA and
# install only that CA root on authorized clients. Public-DNS option: use an
# ACME client such as certbot and its renewal timer.
