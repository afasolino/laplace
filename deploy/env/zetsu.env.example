# Client-side shell environment only. Never commit the value.
# This is a normal owner-bound Laplace bearer token from the Operator token file;
# Zetsu does not have a separate credential authority.
LAPLACE_ZETSU_TOKEN=replace-with-an-owner-bound-laplace-bearer-token
LAPLACE_ZETSU_ENDPOINT=https://laplace.example.org/mcp
