# Copy to a root-owned mode-0600 file such as /etc/laplace/laplace.env.
# This example contains no password, activation code, token, or live hash.
LAPLACE_STATE_ROOT=/var/lib/laplace
LAPLACE_USER_REGISTRY=/var/lib/laplace/auth/registered_users.yaml
LAPLACE_SESSION_STORE=/var/lib/laplace/auth/sessions.sqlite3
LAPLACE_EXTERNAL_URL=https://laplace.example.org
LAPLACE_ALLOWED_HOST=laplace.example.org
LAPLACE_VLLM_EXECUTABLE=/opt/laplace/.venv-vllm-cu129/bin/vllm
LAPLACE_FFMPEG_LIBRARY_PATH=/opt/laplace/.runtime/ffmpeg7/lib
